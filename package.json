{
  "name": "agora",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "check": "pnpm check:repository && pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm test && pnpm check:repository && pnpm check:docs",
    "format:check": "prettier --check .",
    "lint": "oxlint --import-plugin --disable-nested-config --deny-warnings --report-unused-disable-directives-severity=error --ignore-path .gitignore",
    "typecheck": "tsc --project tsconfig.json",
    "check:architecture": "depcruise --config .dependency-cruiser.mjs apps packages plugins dev",
    "test": "pnpm build && node scripts/test.mjs",
    "test:browser": "pnpm build && node scripts/test.mjs browser",
    "clean:dev": "node scripts/clean-development.mjs",
    "task": "python3 scripts/agora-task.py",
    "check:repository": "python3 scripts/check-repository.py",
    "clean:build": "node scripts/clean-build.mjs",
    "check:docs": "python3 scripts/check-doc-links.py",
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && node dist/run.js",
    "start": "node dist/run.js",
    "mock": "pnpm build && node dist/run.js --mock"
  },
  "devDependencies": {
    "@types/diff": "7.0.2",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.25.12",
    "oxlint": "1.92.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/mcp-extensions": "0.1.0",
    "diff": "7.0.0",
    "zod": "4.4.3"
  }
}
