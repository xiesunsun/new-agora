{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true
  },
  "include": [
    ".dependency-cruiser.mjs",
    "apps/**/*",
    "packages/**/*",
    "plugins/**/*",
    "scripts/**/*",
    "tests/**/*"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
